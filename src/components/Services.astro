---
import { services, studio } from '../data/site';
---

<section class="services" id="usluge" aria-label="Usluge">
  {
    services.map((s) => (
      <article class="service">
        <img src={s.image} alt={s.alt} loading="lazy" style={s.focus && `object-position:${s.focus}`} />
        <h2 class="service__title">{s.title}</h2>
        <div class="service__bottom">
          <p class="service__text">{s.text}</p>
          <a class="btn btn--light btn--sm" href={studio.bookingHref} target="_blank" rel="noopener">
            Rezerviši
          </a>
        </div>
      </article>
    ))
  }
</section>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    background: var(--espresso);
  }

  .service {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: clamp(440px, 42vw, 560px);
    padding: 28px 18px 26px;
    overflow: hidden;
    color: var(--cream);
    text-align: center;
  }

  .service img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s ease;
  }

  .service::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(34, 21, 14, 0.5) 0%, rgba(34, 21, 14, 0) 32%),
      linear-gradient(0deg, rgba(34, 21, 14, 0.72) 0%, rgba(34, 21, 14, 0) 45%);
    transition: background-color 0.4s ease;
  }

  .service:hover img {
    transform: scale(1.05);
  }

  .service__title,
  .service__bottom {
    position: relative;
    z-index: 1;
  }

  .service__title {
    font-family: var(--serif);
    font-size: clamp(1.9rem, 2.6vw, 2.5rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1;
  }

  .service__bottom {
    display: grid;
    gap: 16px;
    justify-items: center;
  }

  .service__text {
    max-width: 24ch;
    color: rgba(245, 238, 229, 0.86);
    font-size: 12px;
    line-height: 1.45;
  }

  .service + .service {
    border-left: 1px solid rgba(34, 21, 14, 0.4);
  }

  @media (max-width: 960px) {
    .services {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .services::-webkit-scrollbar {
      display: none;
    }

    .service {
      flex: 0 0 min(72vw, 320px);
      min-height: 460px;
      scroll-snap-align: start;
    }
  }
</style>
