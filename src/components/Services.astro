---
import { services, studio } from '../data/site';
---

<section class="services" id="usluge">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">Naše usluge</p>
      <h2 class="title">Tretmani za tvoj <em>glow</em></h2>
      <p class="intro">
        Od trepavica i obrva, preko preplanulog tena do njegovanih noktiju – svaki detalj je važan.
      </p>
    </header>

    <div class="services__list">
      {
        services.map((s, i) => (
          <article class="service reveal" style={`transition-delay:${i * 90}ms`}>
            <div class="service__media">
              <img
                src={s.image}
                alt={s.alt}
                loading="lazy"
                style={s.focus && `object-position:${s.focus}`}
              />
            </div>
            <div class="service__row">
              <h3 class="service__title">{s.title}</h3>
              <p class="service__price">{s.price}</p>
            </div>
            <p class="service__text">{s.text}</p>
            <a class="link" href={studio.bookingHref} target="_blank" rel="noopener">
              Rezerviši
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    padding-block: var(--section);
    background: var(--paper);
  }

  .services__list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
  }

  .service {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .service__media {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--sand);
  }

  .service__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s ease;
  }

  .service:hover .service__media img {
    transform: scale(1.05);
  }

  .service__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2px 12px;
    width: 100%;
    margin-top: 18px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }

  .service__title {
    color: var(--ink);
    font-family: var(--display);
    font-size: clamp(1.3rem, 1.55vw, 1.5rem);
    font-weight: 400;
    line-height: 1.15;
  }

  .service__price {
    color: var(--accent-dark);
    font-family: var(--serif);
    font-size: 1.05rem;
    font-style: italic;
    white-space: nowrap;
  }

  .service__text {
    flex: 1;
    margin: 12px 0 18px;
    color: var(--text);
    font-size: 13px;
    line-height: 1.6;
  }

  @media (max-width: 1000px) {
    .services__list {
      display: flex;
      gap: 20px;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .services__list::-webkit-scrollbar {
      display: none;
    }

    .service {
      flex: 0 0 min(64vw, 260px);
      scroll-snap-align: start;
    }
  }
</style>
