---
import { nav, studio } from '../data/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<section class="booking" id="kontakt">
  <div class="wrap booking__grid">
    <div class="booking__side booking__side--left" aria-hidden="true">
      <img src="/images/lash-application.webp" alt="" loading="lazy" />
    </div>

    <div class="booking__center reveal">
      <p class="eyebrow">Rezervacije</p>
      <h2 class="title">Rezerviši svoj <em>termin</em></h2>
      <span class="rule" aria-hidden="true"></span>
      <p class="intro">
        Termine zakazujemo putem Instagram poruke ili telefonom. Javi nam se – rado ćemo pronaći
        termin koji ti odgovara.
      </p>
      <div class="booking__actions">
        <a class="btn" href={studio.bookingHref} target="_blank" rel="noopener">Pošalji poruku</a>
        <a class="btn btn--line" href={studio.phoneHref}>Pozovi</a>
      </div>

      <ul class="booking__info">
        <li>
          <Icon name="pin" size={18} />
          <small>Adresa</small>
          <a href={studio.mapHref} target="_blank" rel="noopener">{studio.address}, {studio.city}</a>
        </li>
        <li>
          <Icon name="phone" size={18} />
          <small>Telefon</small>
          <a href={studio.phoneHref}>{studio.phone}</a>
        </li>
        <li>
          <Icon name="instagram" size={18} />
          <small>Instagram</small>
          <a href={studio.instagram} target="_blank" rel="noopener">{studio.instagramHandle}</a>
        </li>
      </ul>
    </div>

    <div class="booking__side booking__side--right" aria-hidden="true">
      <img src="/images/nails-almond-french.webp" alt="" loading="lazy" />
    </div>
  </div>
</section>

<footer class="footer">
  <div class="wrap footer__inner">
    <a href="#top" class="footer__brand" aria-label={`${studio.name} – na vrh`}>
      <Logo tone="light" />
    </a>
    <nav aria-label="Footer navigacija">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <p>© {year} {studio.name} · {studio.tagline}</p>
  </div>
</footer>

<style>
  .booking {
    padding-block: var(--section);
    background: var(--sand);
  }

  .booking__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.4fr) minmax(0, 0.55fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }

  .booking__side {
    aspect-ratio: 3 / 4.4;
    overflow: hidden;
    border-radius: 999px 999px 4px 4px;
  }

  .booking__side--left {
    margin-top: 80px;
  }

  .booking__side--right {
    margin-bottom: 80px;
  }

  .booking__side img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .booking__center {
    display: grid;
    justify-items: center;
    gap: 20px;
    text-align: center;
  }

  .booking__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 8px;
  }

  .booking__info {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    margin: 24px 0 0;
    padding: 28px 0 0;
    border-top: 1px solid var(--line-gold);
    list-style: none;
  }

  .booking__info li {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding-inline: 10px;
    color: var(--accent);
  }

  .booking__info li + li {
    border-left: 1px solid var(--line);
  }

  .booking__info small {
    color: var(--muted);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .booking__info a {
    color: var(--ink);
    font-family: var(--display);
    font-size: 1.05rem;
    line-height: 1.25;
    transition: color 0.25s ease;
  }

  .booking__info a:hover {
    color: var(--accent);
  }

  .footer {
    padding-block: 48px 36px;
    background: var(--espresso-deep);
    color: rgba(246, 239, 230, 0.6);
  }

  .footer__inner {
    display: grid;
    justify-items: center;
    gap: 24px;
    font-size: 12px;
    text-align: center;
  }

  .footer__brand {
    display: flex;
  }

  .footer nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 32px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .footer a:hover {
    color: var(--gold);
  }

  @media (max-width: 900px) {
    .booking__grid {
      grid-template-columns: 1fr;
    }

    .booking__side {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .booking__info {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .booking__info li + li {
      padding-top: 20px;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
