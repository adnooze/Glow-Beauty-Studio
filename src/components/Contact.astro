---
import { nav, services, studio } from '../data/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<section class="booking" id="kontakt">
  <img class="booking__bg" src="/images/brow-lift.webp" alt="" loading="lazy" />
  <div class="wrap booking__inner reveal">
    <h2 class="booking__title">Rezerviši svoj trenutak</h2>
    <ul class="booking__services">
      {services.map((s) => <li>{s.title}</li>)}
    </ul>
    <div class="booking__actions">
      <a class="btn" href={studio.bookingHref} target="_blank" rel="noopener">Pošalji poruku</a>
      <a class="btn btn--outline" href={studio.phoneHref}>Pozovi</a>
    </div>

    <ul class="booking__info">
      <li>
        <Icon name="pin" size={16} />
        <a href={studio.mapHref} target="_blank" rel="noopener">{studio.address}, {studio.city}</a>
      </li>
      <li>
        <Icon name="phone" size={16} />
        <a href={studio.phoneHref}>{studio.phone}</a>
      </li>
      <li>
        <Icon name="instagram" size={16} />
        <a href={studio.instagram} target="_blank" rel="noopener">{studio.instagramHandle}</a>
      </li>
    </ul>
  </div>
</section>

<footer class="footer">
  <div class="wrap footer__inner">
    <a href="#top" class="footer__brand" aria-label={`${studio.name} – na vrh`}>
      <Logo tone="light" size="sm" />
    </a>
    <nav aria-label="Footer navigacija">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <p>© {year} {studio.name} · {studio.tagline}</p>
  </div>
</footer>

<style>
  .booking {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(560px, 70vw, 720px);
    padding-block: clamp(72px, 10vw, 120px);
    overflow: hidden;
    background: var(--espresso);
    color: var(--cream);
    text-align: center;
  }

  .booking__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .booking::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 70% at 50% 50%, rgba(34, 21, 14, 0.55), rgba(34, 21, 14, 0.82)),
      rgba(58, 36, 25, 0.25);
  }

  .booking__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 26px;
  }

  .booking__title {
    font-family: var(--serif);
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .booking__services {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--serif);
    font-size: 1.35rem;
    font-style: italic;
    font-weight: 300;
    color: rgba(245, 238, 229, 0.9);
  }

  .booking__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 6px;
  }

  .booking__info {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px 36px;
    margin: 28px 0 0;
    padding: 26px 0 0;
    border-top: 1px solid rgba(245, 238, 229, 0.2);
    list-style: none;
    font-size: 13px;
  }

  .booking__info li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--gold);
  }

  .booking__info a {
    color: var(--cream);
    transition: color 0.2s ease;
  }

  .booking__info a:hover {
    color: var(--gold);
  }

  .footer {
    padding-block: 32px;
    background: var(--espresso-deep);
    color: rgba(245, 238, 229, 0.6);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    font-size: 12px;
  }

  .footer__brand {
    display: flex;
  }

  .footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
  }

  .footer a:hover {
    color: var(--gold);
  }
</style>
