---
import { features, studio } from '../data/site';
import Icon from './Icon.astro';
---

<section class="about" id="o-nama">
  <div class="about__copy">
    <div class="about__inner reveal">
      <p class="eyebrow">O našem studiju</p>
      <h2 class="display">
        <span>Više od</span>
        <span>beauty</span>
        <em>salona</em>
      </h2>

      <ul class="about__features">
        {
          features.map((f) => (
            <li>
              <Icon name={f.icon as 'shield'} size={17} />
              <span>{f.label}</span>
            </li>
          ))
        }
      </ul>

      <p class="small about__note">
        Svaka posjeta je osmišljena da bude mirna, precizna i opuštajuća – mjesto gdje se
        vrhunska usluga spaja s pažnjom posvećenom baš tebi.
      </p>
    </div>
  </div>

  <div class="about__media">
    <img
      src="/images/salon-glow-sign.webp"
      alt="Svijetleći zidni znak i manikir u Glow Beauty Studiju"
      width="1100"
      height="1389"
      loading="lazy"
    />
    <a class="about__address" href={studio.mapHref} target="_blank" rel="noopener">
      {studio.address},<br />{studio.city}
    </a>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 620px;
  }

  .about__copy {
    display: flex;
    justify-content: flex-end;
    background: var(--blush);
    padding: clamp(56px, 8vw, 96px) var(--gutter);
  }

  .about__inner {
    width: 100%;
    max-width: calc(var(--wrap) / 2 - var(--gutter));
    display: flex;
    flex-direction: column;
  }

  .about .eyebrow {
    margin-bottom: 18px;
  }

  .about__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px 28px;
    margin: clamp(40px, 6vw, 64px) 0 0;
    padding: 0;
    list-style: none;
  }

  .about__features li {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--ink);
    font-size: 10px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .about__features :global(svg) {
    flex: none;
    color: var(--ink);
  }

  .about__note {
    max-width: 30ch;
    margin-top: auto;
    padding-top: 48px;
  }

  .about__media {
    position: relative;
    min-height: 420px;
  }

  .about__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__address {
    position: absolute;
    top: 28px;
    right: 28px;
    padding: 8px 12px;
    background: rgba(40, 28, 28, 0.42);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--white);
    font-size: 10px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.04em;
    text-align: right;
    text-transform: uppercase;
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }

    .about__inner {
      max-width: none;
    }

    .about__media {
      aspect-ratio: 4 / 5;
      min-height: 0;
    }
  }
</style>
