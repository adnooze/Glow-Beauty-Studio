---
import { features, studio } from '../data/site';
import Icon from './Icon.astro';
---

<section class="about" id="o-nama">
  <div class="wrap about__grid">
    <div class="about__visual reveal">
      <div class="about__frame">
        <img
          src="/images/salon-glow-sign.webp"
          alt="Svijetleći zidni znak i manikir u Glow Beauty Studiju"
          width="1100"
          height="1389"
          loading="lazy"
        />
      </div>
      <a class="about__address" href={studio.mapHref} target="_blank" rel="noopener">
        <Icon name="pin" size={14} />
        {studio.address}, {studio.city}
      </a>
    </div>

    <div class="about__copy reveal">
      <p class="eyebrow">O našem studiju</p>
      <h2 class="title">Više od <em>beauty salona</em></h2>
      <span class="rule" aria-hidden="true"></span>
      <p class="intro">
        Svaka posjeta je osmišljena da bude mirna, precizna i opuštajuća – mjesto gdje se vrhunska
        usluga spaja s pažnjom posvećenom baš tebi.
      </p>

      <ul class="about__features">
        {
          features.map((f) => (
            <li>
              <Icon name={f.icon as 'shield'} size={18} />
              <span>{f.label}</span>
            </li>
          ))
        }
      </ul>

      <a class="btn" href={studio.bookingHref} target="_blank" rel="noopener">Rezerviši termin</a>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section);
    background: var(--paper);
  }

  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    gap: clamp(48px, 8vw, 120px);
    align-items: center;
  }

  .about__visual {
    position: relative;
    padding: 22px 22px 0 0;
  }

  .about__visual::before {
    content: '';
    position: absolute;
    inset: 0 0 22px 22px;
    border: 1px solid var(--line-gold);
    border-radius: 999px 999px 4px 4px;
  }

  .about__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 999px 999px 4px 4px;
  }

  .about__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__address {
    position: absolute;
    left: 50%;
    bottom: -18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    transform: translateX(-50%);
    background: var(--espresso);
    border-radius: 999px;
    color: var(--cream);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .about__address :global(svg) {
    color: var(--gold);
  }

  .about__copy {
    display: grid;
    justify-items: start;
    gap: 24px;
  }

  .about__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: 100%;
    margin: 8px 0 12px;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .about__features li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 13.5px;
  }

  .about__features li:nth-child(odd) {
    padding-right: 16px;
  }

  .about__features :global(svg) {
    flex: none;
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__visual {
      width: min(100%, 420px);
      justify-self: center;
    }
  }

  @media (max-width: 480px) {
    .about__features {
      grid-template-columns: 1fr;
    }
  }
</style>
