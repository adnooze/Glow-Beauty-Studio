---
import { pricing, studio } from '../data/site';
---

<section class="prices" id="cjenovnik">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">Cjenovnik</p>
      <h2 class="title">Naše cijene, <em>bez iznenađenja</em></h2>
      <span class="rule" aria-hidden="true"></span>
      <p class="intro">Profesionalna usluga i kvalitetni materijali – po cijenama koje znaš unaprijed.</p>
    </header>

    <div class="prices__menu">
      {
        pricing.map((group) => (
          <article class="price-group reveal">
            <h3>{group.title}</h3>
            <ul>
              {group.rows.map((row) => (
                <li>
                  <span class="price-group__name">
                    {row.name}
                    {row.note && <small>{row.note}</small>}
                  </span>
                  <span class="price-group__dots" aria-hidden="true" />
                  <span class="price-group__price">{row.price}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="prices__cta reveal">
      <a class="btn" href={studio.bookingHref} target="_blank" rel="noopener">Rezerviši termin</a>
      <a class="btn btn--line-light" href={studio.phoneHref}>Pozovi {studio.phone}</a>
    </div>
  </div>
</section>

<style>
  .prices {
    padding-block: var(--section);
    background:
      radial-gradient(50% 40% at 50% 0%, rgba(210, 178, 130, 0.14), transparent 70%),
      var(--espresso);
    color: var(--cream);
  }

  .prices .eyebrow,
  .prices .eyebrow::before {
    color: var(--gold);
  }

  .prices .title {
    color: var(--cream);
  }

  .prices .title em {
    color: var(--gold);
  }

  .prices .intro {
    color: rgba(246, 239, 230, 0.72);
  }

  .prices__menu {
    columns: 2 380px;
    column-gap: clamp(48px, 7vw, 104px);
  }

  .price-group {
    break-inside: avoid;
    margin-bottom: 52px;
  }

  .price-group h3 {
    padding-bottom: 14px;
    margin-bottom: 18px;
    border-bottom: 1px solid rgba(210, 178, 130, 0.3);
    color: var(--gold);
    font-family: var(--serif);
    font-size: 1.9rem;
    font-style: italic;
    font-weight: 300;
    line-height: 1.1;
  }

  .price-group ul {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .price-group li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: 14px;
  }

  .price-group__name {
    display: grid;
    color: var(--cream);
  }

  .price-group__name small {
    color: rgba(246, 239, 230, 0.5);
    font-size: 11.5px;
  }

  .price-group__dots {
    flex: 1;
    min-width: 20px;
    border-bottom: 1px dotted rgba(210, 178, 130, 0.4);
    transform: translateY(-4px);
  }

  .price-group__price {
    color: var(--cream);
    font-family: var(--display);
    font-size: 1.05rem;
    white-space: nowrap;
  }

  .prices__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 16px;
  }
</style>
