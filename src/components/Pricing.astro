---
import { pricing, studio } from '../data/site';
import Logo from './Logo.astro';

const numerals = ['I', 'II', 'III', 'IV', 'V', 'VI'];
---

<section class="prices" id="cjenovnik">
  <div class="wrap">
    <article class="menu reveal">
      <header class="menu__head">
        <Logo />
        <h2 class="menu__title">Cjenovnik</h2>
        <p class="menu__sub">Your Glow, Our Art</p>
      </header>

      <div class="menu__body">
        {
          pricing.map((group, i) => (
            <section class="menu__group">
              <h3>
                <span class="menu__num">{numerals[i]}</span>
                {group.title}
              </h3>
              <ul>
                {group.rows.map((row) => (
                  <li>
                    <span class="menu__name">
                      {row.name}
                      {row.note && <em>{row.note}</em>}
                    </span>
                    <span class="menu__line" aria-hidden="true" />
                    <span class="menu__price">{row.price}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <footer class="menu__foot">
        <p>Sve cijene su izražene u konvertibilnim markama.</p>
        <div class="menu__actions">
          <a class="btn" href={studio.bookingHref} target="_blank" rel="noopener">Rezerviši termin</a>
          <a class="btn btn--line" href={studio.phoneHref}>{studio.phone}</a>
        </div>
      </footer>
    </article>
  </div>
</section>

<style>
  .prices {
    padding-block: var(--section);
    background:
      radial-gradient(60% 50% at 50% 0%, rgba(210, 178, 130, 0.16), transparent 70%),
      var(--espresso);
  }

  /* Krem kartica s dvostrukim zlatnim okvirom – kao štampani meni */
  .menu {
    position: relative;
    max-width: 1040px;
    margin-inline: auto;
    padding: clamp(40px, 6vw, 80px) clamp(24px, 6vw, 88px);
    background: var(--paper);
    color: var(--ink);
    outline: 1px solid rgba(164, 122, 69, 0.55);
    outline-offset: -14px;
    box-shadow: 0 50px 100px -50px rgba(0, 0, 0, 0.7);
  }

  .menu::before {
    content: '';
    position: absolute;
    inset: 20px;
    border: 1px solid rgba(164, 122, 69, 0.25);
    pointer-events: none;
  }

  .menu__head {
    display: grid;
    justify-items: center;
    gap: 10px;
    margin-bottom: clamp(40px, 5vw, 64px);
    text-align: center;
  }

  .menu__title {
    margin-top: 18px;
    font-family: var(--display);
    font-size: clamp(2.4rem, 4.6vw, 3.6rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .menu__sub {
    color: var(--accent);
    font-family: var(--serif);
    font-size: 1.35rem;
    font-style: italic;
    font-weight: 300;
  }

  .menu__body {
    columns: 2 340px;
    column-gap: clamp(40px, 6vw, 88px);
    column-rule: 1px solid var(--line);
  }

  .menu__group {
    break-inside: avoid;
    margin-bottom: 44px;
  }

  .menu__group h3 {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 20px;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 1.85rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.1;
  }

  .menu__num {
    min-width: 2.2em;
    color: var(--accent);
    font-family: var(--display);
    font-size: 0.55em;
    font-style: normal;
    letter-spacing: 0.12em;
  }

  .menu__group ul {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu__group li {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .menu__name {
    display: grid;
    gap: 1px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .menu__name em {
    color: var(--text);
    font-family: var(--serif);
    font-size: 15px;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }

  .menu__line {
    flex: 1;
    min-width: 18px;
    height: 1px;
    background: var(--line);
    transform: translateY(-4px);
  }

  .menu__price {
    font-family: var(--display);
    font-size: 1.15rem;
    white-space: nowrap;
  }

  .menu__foot {
    display: grid;
    justify-items: center;
    gap: 22px;
    margin-top: 12px;
    padding-top: 36px;
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .menu__foot p {
    color: var(--muted);
    font-family: var(--serif);
    font-size: 1.1rem;
    font-style: italic;
  }

  .menu__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  @media (max-width: 760px) {
    .menu__body {
      column-rule: none;
    }

    .menu::before {
      inset: 12px;
    }

    .menu {
      outline-offset: -8px;
    }
  }
</style>
