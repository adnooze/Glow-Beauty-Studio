---
import { pricing, studio } from '../data/site';
---

<section class="prices" id="cjenovnik">
  <p class="prices__watermark" aria-hidden="true">Glow</p>
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">Cjenovnik</p>
        <h2 class="display display--tight">
          <span>Naše cijene</span>
          <em>bez iznenađenja</em>
        </h2>
      </div>
      <div class="section-head__aside">
        <p class="intro">
          Profesionalna usluga, kvalitetni materijali i dugotrajan efekat – <strong>po cijenama koje znaš unaprijed</strong>.
          Sve cijene su u KM.
        </p>
        <div class="section-head__actions">
          <a class="btn" href={studio.bookingHref} target="_blank" rel="noopener">Rezerviši termin</a>
          <a class="link-arrow" href={studio.phoneHref}>Pozovi {studio.phone}</a>
        </div>
      </div>
    </div>

    <div class="prices__grid">
      {
        pricing.map((group) => (
          <article class="price-card reveal">
            <header class="price-card__head">
              <img src={group.image} alt="" loading="lazy" />
              <h3>{group.title}</h3>
            </header>
            <ul>
              {group.rows.map((row) => (
                <li>
                  <span class="price-card__name">
                    {row.name}
                    {row.note && <small>{row.note}</small>}
                  </span>
                  <span class="price-card__dots" aria-hidden="true" />
                  <span class="price-card__price">{row.price}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .prices {
    position: relative;
    overflow: hidden;
    padding-block: clamp(72px, 10vw, 128px);
    border-top: 1px solid var(--line);
  }

  .prices__watermark {
    position: absolute;
    top: 46%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #f1e9de;
    font-size: clamp(9rem, 28vw, 24rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  .prices .wrap {
    position: relative;
  }

  .prices__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 20px;
    align-items: start;
    margin-top: clamp(48px, 7vw, 80px);
  }

  /* Nokti imaju najviše stavki – zauzimaju srednju kolonu kroz dva reda */
  .price-card:nth-child(2) {
    grid-column: 2;
    grid-row: span 2;
  }

  .price-card {
    padding: 22px;
    background: rgba(255, 255, 255, 0.86);
    border: 1px solid var(--line);
    border-radius: 2px;
  }

  .price-card__head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
  }

  .price-card__head img {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
  }

  .price-card h3 {
    color: var(--accent);
    font-family: var(--serif);
    font-size: 1.6rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.1;
  }

  .price-card ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .price-card li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    color: var(--ink);
    font-size: 13px;
  }

  .price-card__name {
    display: grid;
  }

  .price-card__name small {
    color: var(--muted);
    font-size: 11px;
  }

  .price-card__dots {
    flex: 1;
    min-width: 16px;
    border-bottom: 1px dotted #cfc5c2;
    transform: translateY(-4px);
  }

  @media (max-width: 960px) {
    .prices__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .price-card:nth-child(2) {
      grid-column: auto;
    }
  }

  @media (max-width: 640px) {
    .prices__grid {
      grid-template-columns: 1fr;
    }

    .price-card:nth-child(2) {
      grid-row: auto;
    }
  }

  .price-card__price {
    color: var(--ink);
    font-weight: 600;
    white-space: nowrap;
  }
</style>
