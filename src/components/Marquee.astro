---
interface Props {
  items: string[];
}

const { items } = Astro.props;
// Dvije identične trake jedna do druge – pomak za -50% vraća traku na početak bez skoka
const loop = [...items, ...items, ...items, ...items];
---

<div class="marquee" aria-label={items.join(', ')}>
  <div class="marquee__track" aria-hidden="true">
    {
      [0, 1].map(() => (
        <ul>
          {loop.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding-block: 20px;
    font-family: var(--serif);
    font-size: 1.35rem;
    font-style: italic;
    font-weight: 300;
    white-space: nowrap;
    background: var(--espresso);
    color: var(--cream);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 90s linear infinite;
  }

  .marquee ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .marquee li {
    display: flex;
    align-items: center;
  }

  .marquee li::after {
    content: '✦';
    margin-inline: 36px;
    color: var(--gold);
    font-family: var(--sans);
    font-size: 10px;
    font-style: normal;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
