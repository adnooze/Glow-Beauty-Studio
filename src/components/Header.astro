---
import { nav, studio } from '../data/site';
import Logo from './Logo.astro';
---

<header class="header" data-header>
  <div class="wrap header__inner">
    <a href="#top" class="header__logo" aria-label={`${studio.name} – početna`}>
      <Logo tone="inherit" size="sm" />
    </a>
    <nav class="header__nav" aria-label="Glavna navigacija">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="header__cta" href={studio.bookingHref} target="_blank" rel="noopener">Rezerviši</a>
  </div>
</header>

<script>
  // Zaglavlje je providno preko hera, a nakon skrolanja dobija svijetlu pozadinu
  const header = document.querySelector('[data-header]');
  const update = () => header?.classList.toggle('is-solid', window.scrollY > 40);
  update();
  window.addEventListener('scroll', update, { passive: true });
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    color: var(--cream);
    border-bottom: 1px solid transparent;
    transition: background-color 0.4s ease, color 0.4s ease, border-color 0.4s ease;
  }

  .header.is-solid {
    background: rgba(251, 248, 244, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--line);
    color: var(--ink);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    min-height: 76px;
  }

  .header__logo {
    display: flex;
  }

  .header__nav {
    display: flex;
    gap: 36px;
    margin-left: auto;
    font-size: 13px;
  }

  .header__nav a {
    opacity: 0.85;
    transition: opacity 0.25s ease;
  }

  .header__nav a:hover {
    opacity: 1;
  }

  .header__cta {
    padding: 9px 18px;
    border: 1px solid currentColor;
    font-size: 13px;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .header__cta:hover {
    background: var(--cream);
    border-color: var(--cream);
    color: var(--espresso);
  }

  .header.is-solid .header__cta:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--cream);
  }

  @media (max-width: 860px) {
    .header__nav {
      display: none;
    }
  }
</style>
