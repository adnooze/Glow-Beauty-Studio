---
import { nav, studio } from '../data/site';
import Logo from './Logo.astro';
---

<header class="header">
  <div class="wrap header__inner">
    <a href="#top" class="header__logo" aria-label={`${studio.name} – početna`}>
      <Logo tone="light" size="sm" />
    </a>
    <nav class="header__nav" aria-label="Glavna navigacija">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="btn header__cta" href={studio.bookingHref} target="_blank" rel="noopener">Rezerviši</a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--espresso);
    border-bottom: 1px solid rgba(210, 178, 130, 0.18);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 66px;
  }

  .header__logo {
    display: flex;
  }

  .header__nav {
    display: flex;
    gap: 34px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .header__nav a {
    color: rgba(245, 238, 229, 0.82);
    transition: color 0.2s ease;
  }

  .header__nav a:hover {
    color: var(--gold);
  }

  .header__cta {
    min-height: 36px;
    padding: 0 20px;
  }

  @media (max-width: 860px) {
    .header__nav {
      display: none;
    }
  }
</style>
