---
import { portfolio, studio } from '../data/site';

const { feature, items } = portfolio;
---

<section class="work" id="radovi">
  <div class="wrap work__grid">
    <figure class="work__feature reveal">
      <img src={feature.image} alt={feature.alt} loading="lazy" />
      <figcaption>
        <span class="work__feature-title">Naš rad,<br />pravi rezultati</span>
        <span class="work__feature-text">{feature.caption}</span>
      </figcaption>
    </figure>

    <div class="work__side">
      <p class="intro reveal">
        Svaka klijentica je jedinstvena. Ovo su neki od naših radova – urađeni
        <strong>s pažnjom, preciznošću i strašću</strong>.
      </p>
      <div class="work__items">
        {
          items.map((item, i) => (
            <figure class="work__item reveal" style={`transition-delay:${i * 80}ms`}>
              <img src={item.image} alt={item.alt} loading="lazy" />
              <figcaption>
                <span class="work__item-title">{item.title}</span>
                <span class="small">{item.caption}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <a class="btn btn--dark reveal" href={studio.instagram} target="_blank" rel="noopener">Više na Instagramu</a>
    </div>
  </div>
</section>

<style>
  .work {
    padding-block: clamp(56px, 8vw, 96px);
    background: var(--cream);
  }

  .work__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: stretch;
  }

  .work__feature {
    position: relative;
    min-height: 460px;
    margin: 0;
    overflow: hidden;
  }

  .work__feature img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work__feature::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(34, 21, 14, 0.7) 0%, rgba(34, 21, 14, 0) 55%);
  }

  .work__feature figcaption {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 24px;
    z-index: 1;
    display: grid;
    gap: 10px;
    color: var(--cream);
  }

  .work__feature-title {
    font-family: var(--serif);
    font-size: clamp(2.2rem, 3.4vw, 3rem);
    font-style: italic;
    font-weight: 300;
    line-height: 0.95;
  }

  .work__feature-text {
    max-width: 30ch;
    font-size: 12px;
    opacity: 0.85;
  }

  .work__side {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 28px;
  }

  .work__items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    width: 100%;
  }

  .work__item {
    display: grid;
    gap: 12px;
    margin: 0;
  }

  .work__item img {
    width: 100%;
    aspect-ratio: 4 / 4.4;
    object-fit: cover;
  }

  .work__item figcaption {
    display: grid;
    gap: 2px;
  }

  .work__item-title {
    color: var(--ink);
    font-family: var(--serif);
    font-size: 1.45rem;
    font-style: italic;
    line-height: 1.1;
  }

  @media (max-width: 860px) {
    .work__grid {
      grid-template-columns: 1fr;
    }

    .work__feature {
      min-height: 0;
      aspect-ratio: 4 / 5;
    }
  }

  @media (max-width: 520px) {
    .work__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .work__item:last-child {
      grid-column: span 2;
    }

    .work__item:last-child img {
      aspect-ratio: 16 / 10;
    }
  }
</style>
