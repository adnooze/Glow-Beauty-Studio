---
import { studio } from '../data/site';
---

<section class="hero" id="top">
  <div class="hero__panel hero__panel--main">
    <img
      src="/images/lash-application.webp"
      alt="Nadogradnja trepavica u Glow Beauty Studiju"
      width="616"
      height="860"
      fetchpriority="high"
    />
    <div class="hero__copy">
      <p class="hero__eyebrow">Beauty studio · {studio.city}</p>
      <h1 class="hero__title">Your glow,<br />our art.</h1>
      <p class="hero__sub">Trepavice, obrve, nokti i spray tan – na Bulevaru Stup.</p>
      <a class="btn btn--light" href={studio.bookingHref} target="_blank" rel="noopener">Rezerviši termin</a>
    </div>
  </div>
  <div class="hero__panel">
    <img
      src="/images/nails-babyboomer.webp"
      alt="Baby boomer manikir"
      width="1100"
      height="1404"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: min(86vh, 760px);
    min-height: 520px;
    background: var(--espresso);
  }

  .hero__panel {
    position: relative;
    overflow: hidden;
  }

  .hero__panel img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__panel--main::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(34, 21, 14, 0.62) 0%, rgba(34, 21, 14, 0.15) 70%),
      linear-gradient(0deg, rgba(34, 21, 14, 0.55) 0%, rgba(34, 21, 14, 0) 55%);
  }

  .hero__copy {
    position: absolute;
    left: clamp(24px, 5vw, 64px);
    right: 24px;
    bottom: clamp(36px, 7vw, 72px);
    z-index: 1;
    display: grid;
    gap: 14px;
    justify-items: start;
    color: var(--cream);
  }

  .hero__eyebrow {
    color: var(--gold);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hero__title {
    font-family: var(--serif);
    font-size: clamp(3.2rem, 6.4vw, 5.8rem);
    font-style: italic;
    font-weight: 300;
    line-height: 0.92;
    letter-spacing: -0.01em;
  }

  .hero__sub {
    max-width: 30ch;
    margin-bottom: 10px;
    color: rgba(245, 238, 229, 0.85);
    font-size: 14px;
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      height: auto;
      min-height: 0;
    }

    .hero__panel--main {
      height: min(82vh, 640px);
      min-height: 480px;
    }

    .hero__panel:not(.hero__panel--main) {
      display: none;
    }
  }
</style>
